# Template only. A missing product or key prevents startup.
LICENSE_ENVIRONMENT=test
# Default provider preserves the Waffo TEST-only posture. Set stripe for its adapter.
LICENSE_PROVIDER=waffo
LICENSE_DB=/var/lib/writeitdown-license/licenses.db
LICENSE_LISTEN_ADDR=127.0.0.1:8060
LICENSE_TRUST_LOOPBACK_PROXY=true
LICENSE_PRODUCT_ID=
LICENSE_TOKEN_PRIVATE_KEY_FILE=/etc/writeitdown-license/token.pem
WAFFO_TEST_PUBLIC_KEY_FILE=/etc/writeitdown-license/waffo-test-public.pem
# Stripe adapter. Store the populated environment file as root-owned mode 0600.
# Set LICENSE_PROVIDER=stripe and the stable LICENSE_PRODUCT_ID=prod_VUeTDTehcGAqJK.
# Point LICENSE_TOKEN_PRIVATE_KEY_FILE at the host's EXISTING stripe-token.pem.
# Never regenerate or replace that key. Do not change the app product/key/database on a mode switch.
# Switch only LICENSE_ENVIRONMENT, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET and STRIPE_PRICE_ID.
# Waffo public key is unused in Stripe mode. Keep its database separate from Stripe.
# Optional stable app-product fallback if LICENSE_PRODUCT_ID is unset, not a LIVE billing product.
STRIPE_PRODUCT_ID=prod_VUeTDTehcGAqJK
STRIPE_PRICE_ID=price_1UTfAfRs8qwanmEvfAEXBx8i
STRIPE_WEBHOOK_SECRET=
# Accepted key prefixes, mode checks and permissions: services/license/README.md, Stripe adapter.
STRIPE_SECRET_KEY=
STRIPE_API_BASE=https://api.stripe.com
# Optional sensitive TEST evidence. Keep disabled outside an approved capture window.
# LICENSE_CALLBACK_CAPTURE_DIR=/var/lib/writeitdown-license/callback-captures
