# Template only. A missing product or key prevents startup.
LICENSE_ENVIRONMENT=test
# Default provider preserves the Waffo TEST-only posture. Set stripe for its adapter.
LICENSE_PROVIDER=waffo
LICENSE_DB=/var/lib/writeitdown-license/licenses.db
LICENSE_LISTEN_ADDR=127.0.0.1:8060
LICENSE_TRUST_LOOPBACK_PROXY=true
LICENSE_PRODUCT_ID=
LICENSE_TOKEN_PRIVATE_KEY_FILE=/etc/writeitdown-license/token.pem
WAFFO_TEST_PUBLIC_KEY_FILE=/etc/writeitdown-license/waffo-test-public.pem
# Stripe TEST adapter. Store the populated environment file as root-owned mode 0600.
# Set LICENSE_PROVIDER=stripe and LICENSE_PRODUCT_ID=prod_VUeTDTehcGAqJK.
# Waffo public key is unused in Stripe mode. Use a separate Stripe database.
STRIPE_PRODUCT_ID=prod_VUeTDTehcGAqJK
STRIPE_PRICE_ID=price_1UTfAfRs8qwanmEvfAEXBx8i
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_API_BASE=https://api.stripe.com
# Optional sensitive TEST evidence. Keep disabled outside an approved capture window.
# LICENSE_CALLBACK_CAPTURE_DIR=/var/lib/writeitdown-license/callback-captures
